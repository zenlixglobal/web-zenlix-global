# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Used for canonical URLs, the sitemap, OG tags, and admin links inside emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses row-level security, so it must never be prefixed with
# NEXT_PUBLIC_ or referenced from a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Email (Gmail SMTP)
# Leave SMTP_USER/SMTP_PASSWORD unset in development: submissions still save to
# Supabase and the skipped email is logged to the console.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
# 465 = implicit TLS, 587 = STARTTLS.
SMTP_PORT=465
# The full Gmail / Workspace address the app signs in as.
SMTP_USER=
# A Google App Password (16 chars), NOT the account password. Requires 2-Step
# Verification: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=
# Gmail rewrites the From header unless this address is SMTP_USER or an alias
# verified under Gmail → Settings → Accounts → "Send mail as".
CONTACT_FROM_EMAIL="Zenlix Global <notifications@zenlixglobal.com>"
# Comma-separated list of inboxes that receive new enquiries.
CONTACT_TO_EMAIL=info@zenlixglobal.com

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# Secret used to derive the daily-rotating visitor hash. Generate one with
#   openssl rand -hex 32
# and keep it stable: changing it resets visitor identity for the current day,
# which inflates that day's unique-visitor count. If unset, a salt is derived
# from SUPABASE_SERVICE_ROLE_KEY so development works without extra setup.
ANALYTICS_SALT=

# Timezone used to bucket daily/weekly charts, so "today" means a local day.
# Any IANA name. Defaults to Europe/London.
ANALYTICS_TIMEZONE=Europe/London
